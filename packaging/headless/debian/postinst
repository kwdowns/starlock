#!/bin/sh
# starlock-headless postinst
set -e

UNIT=starlock-headless.service
FALLBACK_UNIT=starlock-wifi-fallback.service
FALLBACK_OVERRIDE=/etc/systemd/system/$FALLBACK_UNIT
APP_DIR=/usr/lib/starlock-headless

if [ "$1" = "configure" ]; then
    # Unprivileged system user for the service; `video` gives it the camera.
    if ! getent passwd starlock >/dev/null; then
        adduser --quiet --system --group --no-create-home \
            --home /var/lib/starlock-headless \
            --gecos "Starlock headless" starlock
    fi
    if ! id -nG starlock | grep -qw video; then
        adduser --quiet starlock video
    fi

    # Starlock was called PushNav: on a first install, carry over the old
    # package's config, calibration and logs if they are still there.
    OLD_STATE=/var/lib/pushnav-headless
    NEW_STATE=/var/lib/starlock-headless
    if [ -z "$2" ] && [ -d "$OLD_STATE" ] && [ ! -e "$NEW_STATE" ]; then
        if cp -a "$OLD_STATE" "$NEW_STATE"; then
            chown -R starlock:starlock "$NEW_STATE" || true
        fi
    fi

    # Wi-Fi hotspot fallback: make sure the NetworkManager "starlock-hotspot"
    # connection exists (autoconnect off; the fallback unit starts it when no
    # network is available). Only creates it when missing; never touches a
    # running connection. Silent without NetworkManager (containers).
    "$APP_DIR/wifi-fallback" ensure-profile || true

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        # Enable on first install only, so a later upgrade doesn't undo a
        # `systemctl disable starlock-headless` the user chose.
        if [ -z "$2" ]; then
            systemctl enable "$UNIT" >/dev/null 2>&1 || true
        fi
        # The Wi-Fi fallback is new in 0.5.1: also switch it on when upgrading
        # from an older version, then leave the user's choice alone. It only
        # takes effect at the next boot (and does nothing while a network is
        # connected), so this never changes the connection in use.
        if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.5.1~; then
            systemctl enable "$FALLBACK_UNIT" >/dev/null 2>&1 || true
        fi
        # A hand-installed unit of the same name in /etc/systemd/system
        # overrides the packaged one (and keeps running its own script). Leave
        # it alone, but say so.
        if [ -f "$FALLBACK_OVERRIDE" ] && [ ! -L "$FALLBACK_OVERRIDE" ]; then
            echo ""
            echo "Note: $FALLBACK_OVERRIDE exists and overrides the"
            echo "Wi-Fi fallback that now ships with this package. It was left as it is."
            echo "To use the packaged one, which waits longer for slow Wi-Fi and logs"
            echo "to the journal, run:"
            echo "  sudo systemctl disable starlock-wifi-fallback"
            echo "  sudo rm $FALLBACK_OVERRIDE /usr/local/sbin/starlock-wifi-fallback"
            echo "  sudo systemctl daemon-reload && sudo systemctl enable starlock-wifi-fallback"
        fi
        if systemctl is-enabled --quiet "$UNIT"; then
            systemctl restart "$UNIT" || true
        fi
    fi

    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo ""
    echo "Starlock headless is installed."
    echo "  Open on your phone (same Wi-Fi):  http://${ip:-<pi-ip>}:8780"
    echo "  Service:  sudo systemctl status starlock-headless"
    echo "  Logs:     journalctl -u starlock-headless -f"
    echo ""
fi

exit 0
